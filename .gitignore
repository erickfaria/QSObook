# Local executables and build output (root directories)
/bin/
/dist/
/qsobook
/QSObook
*.exe
*.test

# Coverage and development profiles
/coverage.out
/coverage.html
*.prof

# Runtime data: never commit personal contacts or local backups
/data/
/backups/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Allow explicitly maintained synthetic SQLite fixtures
!**/testdata/*.db
!**/testdata/*.sqlite
!**/testdata/*.sqlite3

# Private local configuration; examples remain trackable
.env
.env.*
!.env.example
!.env.*.example

# Temporary development files
/tmp/
*.tmp
*.log
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Keep go.mod, go.sum, SQL, fonts and assets trackable.

# Local caches: keep builds and downloads inside the project
/.cache/

# Private local access password files
/secrets/
